# Copy to .env and fill in. Keep .env private: chmod 600 .env
# The folder you want to reach. Use a dedicated directory, not / and not your whole home.
LIBRE_POTATO_FILES_ROOT=/home/dylan/Potato

# Sign-in. Username is plain text. Password is a hash from:
#   python -m app.hash_password
LIBRE_POTATO_USERNAME=dylan
LIBRE_POTATO_PASSWORD_HASH=replace-with-scrypt-hash

# Cookie signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LIBRE_POTATO_SECRET_KEY=replace-with-long-random-string

# Stay on localhost unless you have a firewall plan. Tailscale can reach localhost.
LIBRE_POTATO_HOST=127.0.0.1
LIBRE_POTATO_PORT=8787

# Set to 1 when a reverse proxy terminates HTTPS.
LIBRE_POTATO_HTTPS_ONLY=0

# Largest single upload, in megabytes.
LIBRE_POTATO_MAX_UPLOAD_MB=512
